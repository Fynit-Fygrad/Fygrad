---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { ArrowRight, ChevronDown } from 'lucide-react';
---

<Layout title="Contacto | FyGrad">
  <Navbar />

  <main class="w-full flex flex-col items-center bg-white">
    
    {/* 1. Hero Contacto */}
    <section class="w-full bg-[#132338] pt-32 pb-24 px-8 relative overflow-hidden flex justify-center">
      {/* Decorative Background Shapes */}
      <div class="absolute top-0 right-0 w-200 h-200 bg-[#1a2c47] rounded-full blur-[100px] -translate-y-1/2 translate-x-1/3 opacity-50 pointer-events-none"></div>
      <div class="absolute bottom-0 left-1/4 w-150 h-150 bg-[#0c1624] rounded-full blur-[120px] translate-y-1/3 opacity-80 pointer-events-none"></div>
      
      {/* Curve overlay for the bottom edge */}
      <div class="absolute -bottom-37.5 left-1/2 -translate-x-1/2 w-[150%] h-50 bg-white rounded-[100%]"></div>

      <div class="max-w-6xl lg:max-w-300 w-full relative z-10 flex flex-col pt-4 pb-12">
        <div class="flex items-center space-x-2 text-sm font-bold tracking-widest mb-6 uppercase">
          <span class="text-[#8c96a4]">INICIO</span>
          <span class="text-[#e68424]">/</span>
          <span class="text-[#e68424]">CONTACTO</span>
        </div>
        
        <h1 class="text-5xl md:text-7xl lg:text-[6rem] font-black leading-none tracking-tighter uppercase mb-6 max-w-4xl text-white">
          CONTACTO
        </h1>
        
        <p class="text-[#8c96a4] text-lg md:text-xl max-w-xl leading-relaxed mb-4">
          Cuéntanos sobre tu manuscrito, tu base de datos o el servicio que necesitas. Respondemos en un plazo máximo de 2 días hábiles.
        </p>
      </div>
    </section>

    {/* 2. Sección Principal de Contacto */}
    <section class="w-full px-8 flex justify-center py-16 pb-32">
      <div class="max-w-6xl lg:max-w-300 w-full flex flex-col md:flex-row gap-16 md:gap-12 lg:gap-24">
        
        {/* Columna Izquierda: Información */}
        <div class="w-full md:w-1/3 flex flex-col">
          <div class="border-l-2 border-gray-100 pl-6 flex flex-col space-y-10">
            
            {/* Block 1 */}
            <div>
              <span class="text-slate-400 font-bold text-[10px] tracking-widest uppercase mb-2 inline-block">
                [ EMAIL ]
              </span>
              <h3 class="text-[#121a2f] font-black text-lg mb-1">Consultas Generales</h3>
              <p class="text-gray-400 text-sm">hola@fygrad.pe</p>
            </div>

            {/* Block 2 */}
            <div>
              <span class="text-slate-400 font-bold text-[10px] tracking-widest uppercase mb-2 inline-block">
                [ TELÉFONO ]
              </span>
              <h3 class="text-[#121a2f] font-black text-lg mb-1">Atención Directa</h3>
              <p class="text-gray-400 text-sm">+51 999 999 999</p>
            </div>

            {/* Block 3 */}
            <div>
              <span class="text-slate-400 font-bold text-[10px] tracking-widest uppercase mb-2 inline-block">
                [ HORARIOS ]
              </span>
              <h3 class="text-[#121a2f] font-black text-lg mb-1">Horario de Recepción</h3>
              <p class="text-gray-400 text-sm">Lunes a viernes, de 9:00 a 18:00</p>
            </div>

          </div>
        </div>

        {/* Columna Derecha: Formulario */}
        <div class="w-full md:w-2/3">
          <div class="bg-white border border-gray-200 rounded-3xl p-8 lg:p-12 shadow-sm">
            
            <form class="flex flex-col gap-6" onsubmit="event.preventDefault();">
              
              {/* Row 1: Nombre & Correo */}
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                
                <div class="flex flex-col">
                  <label class="text-[#121a2f] font-bold text-xs uppercase mb-2" for="nombre">Nombre Completo</label>
                  <input 
                    type="text" 
                    id="nombre"
                    placeholder="Tu nombre" 
                    class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm text-[#121a2f] outline-none focus:border-[#e68424] transition-colors placeholder:text-gray-400"
                  />
                </div>

                <div class="flex flex-col">
                  <label class="text-[#121a2f] font-bold text-xs uppercase mb-2" for="correo">Correo Electrónico</label>
                  <input 
                    type="email" 
                    id="correo"
                    placeholder="nombre@correo.com" 
                    class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm text-[#121a2f] outline-none focus:border-[#e68424] transition-colors placeholder:text-gray-400"
                  />
                </div>

              </div>

              {/* Row 2: Select */}
              <div class="flex flex-col relative">
                <label class="text-[#121a2f] font-bold text-xs uppercase mb-2" for="servicio">Laboratorio de interés</label>
                <div class="relative">
                  <select 
                    id="servicio"
                    class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm text-[#121a2f] outline-none focus:border-[#e68424] transition-colors appearance-none bg-white cursor-pointer"
                  >
                    <option>Publication — Soporte Editorial</option>
                    <option>Academy — Mentoring y Asesoría</option>
                    <option>Review — Revisión de Pares</option>
                    <option>Research — Colaboración Académica</option>
                    <option>Development — Análisis de Datos</option>
                  </select>
                  <div class="absolute inset-y-0 right-4 flex items-center pointer-events-none">
                    <ChevronDown size={16} className="text-gray-400" />
                  </div>
                </div>
              </div>

              {/* Row 3: Textarea */}
              <div class="flex flex-col">
                <label class="text-[#121a2f] font-bold text-xs uppercase mb-2" for="mensaje">Breve Descripción</label>
                <textarea 
                  id="mensaje"
                  rows={4}
                  placeholder="Describe brevemente de qué trata tu estudio o qué necesitas..." 
                  class="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm text-[#121a2f] outline-none focus:border-[#e68424] transition-colors placeholder:text-gray-400 resize-none"
                ></textarea>
              </div>

              {/* Submit Button */}
              <div class="mt-4 flex justify-center">
                <button type="submit" class="w-full sm:w-auto bg-[#e68424] hover:bg-[#cf741d] text-white font-bold text-sm px-10 py-3.5 rounded-full transition-colors flex items-center justify-center space-x-2">
                  <span>Enviar Consulta</span>
                  <ArrowRight size={16} />
                </button>
              </div>

            </form>

          </div>
        </div>

      </div>
    </section>

  </main>
  
  <Footer />
</Layout>
