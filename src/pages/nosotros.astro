---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { Star, Globe, Heart, ArrowRight } from "lucide-react";
---

<Layout title="Nosotros | FyGrad">
  <Navbar />

  <main class="w-full flex flex-col items-center">
    {/* 1. Hero Section */}
    <section
      class="w-full bg-[#132338] pt-32 pb-24 px-8 relative overflow-hidden flex justify-center"
    >
      {/* Decorative Background Shapes */}
      <div
        class="absolute top-0 right-0 w-200 h-200 bg-[#1a2c47] rounded-full blur-[100px] -translate-y-1/2 translate-x-1/3 opacity-50"
      >
      </div>
      <div
        class="absolute bottom-0 left-0 w-150 h-150 bg-[#0c1624] rounded-full blur-[120px] translate-y-1/3 -translate-x-1/4 opacity-80"
      >
      </div>

      <div
        class="max-w-6xl lg:max-w-300 w-full grid grid-cols-1 lg:grid-cols-2 gap-16 relative z-10"
      >
        <div class="flex flex-col justify-center">
          <div
            class="flex items-center space-x-2 text-sm font-bold tracking-widest mb-6 uppercase"
          >
            <span class="text-[#8c96a4]">INICIO</span>
            <span class="text-[#e68424]">/</span>
            <span class="text-[#e68424]">NOSOTROS</span>
          </div>
          <h3
            class="text-[#e68424] font-black tracking-widest uppercase text-sm mb-4"
          >
            SOBRE FYGRAD
          </h3>
          <h1
            class="text-5xl md:text-7xl lg:text-[5.5rem] font-black text-white leading-[0.95] tracking-tighter mb-8"
          >
            <span class="block">UN LAB QUE</span>
            <span class="block text-[#e68424]">TE ACOMPAÑA</span>
            <span class="block">HASTA EL DOI.</span>
          </h1>
          <p class="text-[#8c96a4] text-lg md:text-xl max-w-lg leading-relaxed">
            FyGrad es un Research Lab de investigación científica. Trabajamos
            con investigadores, docentes y posgradistas que quieren publicar
            bien no solo publicar rápido.
          </p>
        </div>

        {/* Placeholder Image Box */}
        <div class="flex justify-center items-center lg:justify-end">
          <div
            class="w-full max-w-md h-100 lg:h-125 bg-[#22334b] rounded-2xl shadow-2xl relative overflow-hidden"
          >
            <div
              class="absolute inset-0 bg-linear-to-tr from-[#132338] to-transparent opacity-50"
            >
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* 2. Valores Section */}
    <section class="w-full bg-white py-24 px-8 flex justify-center">
      <div class="max-w-6xl lg:max-w-300 w-full flex flex-col">
        <div class="mb-16">
          <h3
            class="text-[#e68424] font-black tracking-widest uppercase text-sm mb-4"
          >
            LO QUE NOS IMPORTA
          </h3>
          <h2
            class="text-4xl md:text-5xl lg:text-6xl font-black text-[#121a2f] leading-none tracking-tighter uppercase max-w-3xl"
          >
            EN QUÉ CREEMOS CUANDO HACEMOS CIENCIA
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {/* Card 1 */}
          <div
            class="bg-white border border-gray-100 rounded-3xl p-8 md:p-10 shadow-sm flex flex-col items-start"
          >
            <div
              class="w-12 h-12 rounded-xl bg-[#fff5eb] flex items-center justify-center text-[#e68424] mb-8"
            >
              <Star size={24} strokeWidth={2.5} />
            </div>
            <h4 class="text-xl font-bold text-[#121a2f] mb-4">
              Primero los datos, luego el texto
            </h4>
            <p class="text-gray-500 text-sm md:text-base leading-relaxed">
              Si la metodología no aguanta, no arrancamos a escribir. La solidez
              del análisis es lo primero que miramos en cada proyecto.
            </p>
          </div>

          {/* Card 2 */}
          <div
            class="bg-white border border-gray-100 rounded-3xl p-8 md:p-10 shadow-sm flex flex-col items-start"
          >
            <div
              class="w-12 h-12 rounded-xl bg-[#fff5eb] flex items-center justify-center text-[#e68424] mb-8"
            >
              <Globe size={24} strokeWidth={2.5} />
            </div>
            <h4 class="text-xl font-bold text-[#121a2f] mb-4">
              La firma siempre es tuya
            </h4>
            <p class="text-gray-500 text-sm md:text-base leading-relaxed">
              Acompañamos, corregimos y proponemos pero la investigación, las
              decisiones de fondo y la autoría son del investigador. Sin
              excepciones.
            </p>
          </div>

          {/* Card 3 */}
          <div
            class="bg-white border border-gray-100 rounded-3xl p-8 md:p-10 shadow-sm flex flex-col items-start"
          >
            <div
              class="w-12 h-12 rounded-xl bg-[#fff5eb] flex items-center justify-center text-[#e68424] mb-8"
            >
              <Heart size={24} strokeWidth={2.5} />
            </div>
            <h4 class="text-xl font-bold text-[#121a2f] mb-4">
              Estamos hasta que aparezca el DOI
            </h4>
            <p class="text-gray-500 text-sm md:text-base leading-relaxed">
              No cerramos el caso con la sumisión. Respondemos a revisores,
              ajustamos lo que sea necesario y te acompañamos hasta la
              publicación final.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* 3. Misión / Visión Section */}
    <section class="w-full bg-[#121a2f] py-24 px-8 flex justify-center">
      <div class="max-w-6xl lg:max-w-300 w-full flex flex-col">
        <div class="mb-16">
          <h2
            class="text-4xl md:text-5xl lg:text-6xl font-black leading-none tracking-tighter uppercase mb-6"
          >
            <span class="text-white block">PARA QUÉ</span>
            <span class="text-[#e68424] block">EXISTIMOS</span>
          </h2>
          <p class="text-[#8c96a4] text-lg md:text-xl max-w-lg">
            Hay mucha ciencia buena que nunca llega a publicarse. Existimos para
            cerrar esa brecha.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 relative">
          {/* Decorative curved backgrounds behind cards */}
          <div
            class="absolute inset-0 flex justify-between pointer-events-none opacity-20 z-0"
          >
            <div
              class="w-1/2 h-full bg-linear-to-r from-transparent to-[#ffffff] rounded-full blur-3xl scale-150 translate-x-1/4"
            >
            </div>
          </div>

          {/* Mision */}
          <div
            class="bg-[#182336] rounded-4xl p-10 md:p-12 relative z-10 border border-white/5"
          >
            <div class="flex items-center space-x-3 mb-8">
              <div class="w-6 h-0.5 bg-[#00a2af]"></div>
              <span
                class="text-[#00a2af] font-bold text-sm tracking-widest uppercase"
                >MISIÓN</span
              >
            </div>
            <h3
              class="text-2xl md:text-3xl font-bold text-white mb-6 leading-tight"
            >
              Que el trabajo de años no termine en una gaveta
            </h3>
            <p class="text-[#8c96a4] leading-relaxed">
              Acompañamos a investigadores desde que tienen una idea o un
              borrador hasta que su trabajo aparece publicado en una revista
              indexada con el rigor que el proceso exige.
            </p>
          </div>

          {/* Vision */}
          <div
            class="bg-[#182336] rounded-4xl p-10 md:p-12 relative z-10 border border-white/5"
          >
            <div class="flex items-center space-x-3 mb-8">
              <div class="w-6 h-0.5 bg-[#00a2af]"></div>
              <span
                class="text-[#00a2af] font-bold text-sm tracking-widest uppercase"
                >VISIÓN</span
              >
            </div>
            <h3
              class="text-2xl md:text-3xl font-bold text-white mb-6 leading-tight"
            >
              Que publicar en Q1 deje de sentirse imposible desde Latinoamérica
            </h3>
            <p class="text-[#8c96a4] leading-relaxed">
              Queremos ser el referente en consultoría editorial científica de
              la región no el más grande, sino el más confiable para quienes
              hacen ciencia de verdad.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* 4. Logros Section */}
    <section class="w-full bg-white py-24 px-8 flex justify-center">
      <div class="max-w-6xl lg:max-w-300 w-full flex flex-col items-center">
        <h2
          class="text-3xl md:text-5xl lg:text-[3.5rem] font-black text-[#121a2f] leading-none tracking-tighter uppercase mb-16 text-center max-w-3xl"
        >
          FELICES DE NUESTROS<br />LOGROS
        </h2>

        <div
          class="w-full border border-gray-200 rounded-4xl md:rounded-[3rem] overflow-hidden"
        >
          <div
            class="grid grid-cols-1 md:grid-cols-4 divide-y md:divide-y-0 md:divide-x divide-gray-200 bg-white"
          >
            <div
              class="flex flex-col items-center justify-center p-10 text-center"
            >
              <div
                class="text-[#e68424] font-black text-6xl md:text-[5rem] leading-none mb-4"
              >
                3
              </div>
              <p
                class="text-gray-500 font-bold text-sm md:text-base leading-tight max-w-37.5"
              >
                Años en el ecosistema editorial
              </p>
            </div>

            <div
              class="flex flex-col items-center justify-center p-10 text-center"
            >
              <div
                class="text-[#e68424] font-black text-6xl md:text-[5rem] leading-none mb-4 flex items-center"
              >
                80<span class="text-5xl md:text-6xl text-[#121a2f] ml-1">+</span
                >
              </div>
              <p
                class="text-gray-500 font-bold text-sm md:text-base leading-tight max-w-37.5"
              >
                Artículos publicados
              </p>
            </div>

            <div
              class="flex flex-col items-center justify-center p-10 text-center"
            >
              <div
                class="text-[#e68424] font-black text-6xl md:text-[5rem] leading-none mb-4 flex items-center"
              >
                20<span class="text-5xl md:text-6xl text-[#121a2f] ml-1">+</span
                >
              </div>
              <p
                class="text-gray-500 font-bold text-sm md:text-base leading-tight max-w-37.5"
              >
                Especialistas en el equipo
              </p>
            </div>

            <div
              class="flex flex-col items-center justify-center p-10 text-center"
            >
              <div
                class="text-[#e68424] font-black text-6xl md:text-[5rem] leading-none mb-4"
              >
                3
              </div>
              <p
                class="text-gray-500 font-bold text-sm md:text-base leading-tight max-w-37.5"
              >
                Países con alcance activo
              </p>
            </div>
          </div>
        </div>

        <p class="text-gray-400 text-sm mt-8 text-center max-w-2xl">
          Publicaciones en Scopus, Web of Science y otras bases de datos de
          acceso abierto reconocidas internacionalmente.
        </p>
      </div>
    </section>

    {/* 5. Equipo CTA Section */}
    <section class="w-full bg-[#121a2f] py-24 px-8 flex justify-center">
      <div
        class="max-w-6xl lg:max-w-300 w-full flex flex-col md:flex-row justify-between items-start md:items-center gap-10"
      >
        <div class="flex flex-col max-w-2xl">
          <h3
            class="text-[#e68424] font-black tracking-widest uppercase text-xs md:text-sm mb-4"
          >
            EL EQUIPO
          </h3>
          <h2
            class="text-3xl md:text-4xl font-bold text-white leading-tight mb-6"
          >
            Detrás de cada publicación hay personas, no plantillas
          </h2>
          <p class="text-[#8c96a4] text-base md:text-lg">
            Investigadores, bioestadísticos, editores de manuscritos y
            comunicadores científicos que trabajan juntos en cada proyecto.<br
            />
            Conócelos.
          </p>
        </div>

        <div>
          <a
            href="/equipo"
            class="inline-flex items-center space-x-3 px-8 py-4 rounded-full border border-white/20 text-white hover:bg-white/5 transition-colors font-semibold text-sm"
          >
            <span>Ver equipo completo</span>
            <ArrowRight size={16} />
          </a>
        </div>
      </div>
    </section>

    {/* 6. Contacto CTA Section */}
    <section class="w-full bg-[#f8fafc] py-32 px-8 flex justify-center">
      <div class="max-w-4xl w-full flex flex-col items-center text-center">
        <h2
          class="text-4xl md:text-5xl lg:text-6xl font-black text-[#121a2f] leading-none tracking-tighter uppercase mb-6"
        >
          ¿TIENES ALGO PARA<br />PUBLICAR?
        </h2>
        <p class="text-gray-500 text-lg mb-10 max-w-lg">
          Aunque sea un borrador o una idea. Lo evaluamos y te decimos qué hace
          falta con honestidad.
        </p>
        <a
          href="/contacto"
          class="inline-flex items-center space-x-3 px-8 py-4 rounded-full border border-[#121a2f] text-[#121a2f] hover:bg-gray-100 transition-colors font-bold text-sm"
        >
          <span>Escríbenos</span>
          <ArrowRight size={16} />
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
