---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { ArrowRight } from 'lucide-react';
---

<Layout title="Ecosistema | FyGrad">
  <Navbar />

  <main class="w-full flex flex-col items-center">
    
    {/* 1. Hero Ecosistema */}
    <section class="w-full bg-[#132338] pt-32 pb-32 px-8 relative overflow-hidden flex justify-center">
      {/* Decorative Background Shapes */}
      <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-[#1a2c47] rounded-full blur-[100px] -translate-y-1/2 translate-x-1/3 opacity-50"></div>
      <div class="absolute bottom-0 left-1/4 w-[600px] h-[600px] bg-[#0c1624] rounded-full blur-[120px] translate-y-1/3 opacity-80"></div>
      
      {/* Curve overlay for the bottom edge */}
      <div class="absolute -bottom-[200px] left-1/2 -translate-x-1/2 w-[150%] h-[300px] bg-white rounded-[100%] opacity-10"></div>

      <div class="max-w-6xl lg:max-w-[75rem] w-full relative z-10 flex flex-col pb-8">
        <div class="flex items-center space-x-2 text-sm font-bold tracking-widest mb-6 uppercase">
          <span class="text-[#8c96a4]">INICIO</span>
          <span class="text-[#e68424]">/</span>
          <span class="text-[#e68424]">ECOSISTEMA</span>
        </div>
        
        <h1 class="text-5xl md:text-6xl lg:text-[5.5rem] font-black leading-[1] tracking-tighter uppercase mb-6 max-w-5xl">
          <span class="text-white">ECOSISTEMA</span>
          <span class="text-[#e68424]">ACADÉMICO</span>
        </h1>
        
        <p class="text-[#8c96a4] text-lg md:text-xl max-w-2xl leading-relaxed">
          Trabajamos junto a bases de indexación, sociedades científicas y editoriales para ampliar el impacto de las publicaciones científicas.
        </p>
      </div>
    </section>

    {/* 2. Stats Row (Overlapping the hero and white section) */}
    <section class="w-full bg-white px-8 flex justify-center pb-24">
      <div class="max-w-6xl lg:max-w-[75rem] w-full flex flex-col items-center relative z-20 -mt-16">
        
        <div class="w-full bg-white border border-gray-100 rounded-[2rem] shadow-sm overflow-hidden">
          <div class="grid grid-cols-1 md:grid-cols-4 divide-y md:divide-y-0 md:divide-x divide-gray-100">
            
            <div class="flex flex-col items-center justify-center p-10 text-center">
              <div class="text-[#e68424] font-black text-4xl md:text-5xl leading-none mb-3">120+</div>
              <p class="text-[#94a3b8] font-bold text-xs uppercase tracking-widest">Artículos Publicados</p>
            </div>

            <div class="flex flex-col items-center justify-center p-10 text-center">
              <div class="text-[#e68424] font-black text-4xl md:text-5xl leading-none mb-3">30+</div>
              <p class="text-[#94a3b8] font-bold text-xs uppercase tracking-widest">Revistas Indexadas</p>
            </div>

            <div class="flex flex-col items-center justify-center p-10 text-center">
              <div class="text-[#e68424] font-black text-4xl md:text-5xl leading-none mb-3">1</div>
              <p class="text-[#94a3b8] font-bold text-xs uppercase tracking-widest">Países Alcanzados</p>
            </div>

            <div class="flex flex-col items-center justify-center p-10 text-center">
              <div class="text-[#e68424] font-black text-4xl md:text-5xl leading-none mb-3">45+</div>
              <p class="text-[#94a3b8] font-bold text-xs uppercase tracking-widest">Investigadores Acompañados</p>
            </div>

          </div>
        </div>

      </div>
    </section>

    {/* 3. Logos (Indexaciones) */}
    <section class="w-full bg-[#fcfcfd] py-16 px-8 flex justify-center">
      <div class="max-w-5xl w-full flex flex-col items-center text-center">
        
        <h2 class="text-xl md:text-2xl font-black text-[#64748b] leading-tight tracking-widest uppercase mb-12">
          INDEXACIONES Y ESTÁNDARES<br/>EDITORIALES
        </h2>

        {/* Temporary placeholders for logos until uploaded to /assets/ */}
        <div class="flex flex-wrap justify-center items-center gap-10 md:gap-16 opacity-80">
          
          <div class="flex items-center space-x-2 text-[#e68424] hover:opacity-100 transition-opacity grayscale hover:grayscale-0">
             {/* Replace with <img src="/assets/logos/scopus.png" alt="Scopus" class="h-10 object-contain" /> */}
             <div class="text-3xl font-black italic tracking-tighter">Scopus</div>
          </div>

          <div class="flex items-center space-x-2 text-[#e68424] hover:opacity-100 transition-opacity grayscale hover:grayscale-0">
             {/* Replace with <img src="/assets/logos/scielo.png" alt="SciELO" class="h-10 object-contain" /> */}
             <div class="text-3xl font-black italic tracking-tighter">SciELO</div>
          </div>

          <div class="flex items-center space-x-2 text-[#e68424] hover:opacity-100 transition-opacity grayscale hover:grayscale-0">
             {/* Replace with <img src="/assets/logos/ieee.png" alt="IEEE" class="h-10 object-contain" /> */}
             <div class="text-4xl font-black tracking-widest">IEEE</div>
          </div>

          <div class="flex items-center space-x-2 text-[#e68424] hover:opacity-100 transition-opacity grayscale hover:grayscale-0">
             {/* Replace with <img src="/assets/logos/acm.png" alt="ACM" class="h-10 object-contain" /> */}
             <div class="text-3xl font-black uppercase tracking-tighter">ACM</div>
          </div>

          <div class="flex items-center space-x-2 text-[#e68424] hover:opacity-100 transition-opacity grayscale hover:grayscale-0">
             {/* Replace with <img src="/assets/logos/springer.png" alt="Springer" class="h-10 object-contain" /> */}
             <div class="text-3xl font-black tracking-tight">Springer</div>
          </div>

        </div>

      </div>
    </section>

    {/* 4. Colaboraciones Activas */}
    <section class="w-full bg-white py-24 px-8 flex justify-center">
      <div class="max-w-6xl lg:max-w-[75rem] w-full flex flex-col">
        
        <h2 class="text-3xl md:text-4xl font-black text-[#121a2f] leading-none tracking-tighter uppercase mb-12">
          COLABORACIONES ACTIVAS
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          
          {/* Card 1 */}
          <div class="bg-white border border-gray-100 rounded-3xl p-8 shadow-sm flex flex-col hover:-translate-y-1 transition-transform">
            <span class="text-[#94a3b8] font-bold text-[10px] tracking-widest uppercase mb-6 inline-block">[ ACADÉMICO ]</span>
            <h3 class="text-[#121a2f] font-black text-xl mb-4">Universidades</h3>
            <p class="text-gray-500 text-sm leading-relaxed">
              Convenios de investigación conjunta, asesoría metodológica y programas de formación continua para docentes investigadores.
            </p>
          </div>

          {/* Card 2 */}
          <div class="bg-white border border-gray-100 rounded-3xl p-8 shadow-sm flex flex-col hover:-translate-y-1 transition-transform">
            <span class="text-[#94a3b8] font-bold text-[10px] tracking-widest uppercase mb-6 inline-block">[ EDITORIAL ]</span>
            <h3 class="text-[#121a2f] font-black text-xl mb-4">Sociedades Científicas</h3>
            <p class="text-gray-500 text-sm leading-relaxed">
              Soporte editorial para revistas institucionales, asegurando el cumplimiento de estándares internacionales de indexación.
            </p>
          </div>

          {/* Card 3 */}
          <div class="bg-white border border-gray-100 rounded-3xl p-8 shadow-sm flex flex-col hover:-translate-y-1 transition-transform">
            <span class="text-[#94a3b8] font-bold text-[10px] tracking-widest uppercase mb-6 inline-block">[ COOPERACIÓN ]</span>
            <h3 class="text-[#121a2f] font-black text-xl mb-4">Redes de Investigación</h3>
            <p class="text-gray-500 text-sm leading-relaxed">
              Vínculos activos con investigadores y laboratorios internacionales para co-autorías y transferencia tecnológica.
            </p>
          </div>

        </div>

      </div>
    </section>

    {/* 5. CTA Final */}
    <section class="w-full bg-[#f8fafc] py-24 px-8 flex justify-center text-center">
      <div class="max-w-2xl w-full flex flex-col items-center">
        <h2 class="text-3xl md:text-5xl font-black text-[#121a2f] leading-none tracking-tighter uppercase mb-6">
          ¿QUIERES SUMAR A TU<br/>INSTITUCIÓN?
        </h2>
        <p class="text-gray-500 text-sm md:text-base leading-relaxed mb-10">
          Escríbenos y conversemos sobre convenios, programas de capacitación institucional y alianzas de investigación.
        </p>
        <a href="#" class="inline-flex items-center space-x-3 border border-[#121a2f] text-[#121a2f] hover:bg-gray-100 px-8 py-3.5 rounded-full font-bold transition-colors text-sm">
          <span>Conversar con el equipo</span>
          <ArrowRight size={14} />
        </a>
      </div>
    </section>

  </main>
  
  <Footer />
</Layout>
