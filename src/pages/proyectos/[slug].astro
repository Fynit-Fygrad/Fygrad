---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { ArrowLeft, ArrowRight } from 'lucide-react';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

// Remove the old dynamic split since we added explicit ones to data
const titlePart1 = project.heroTitlePart1 || project.title.toUpperCase();
const titlePart2 = project.heroTitlePart2 || '';
---

<Layout title={`${project.title} | FyGrad`}>
  <Navbar />

  <main class="w-full flex flex-col items-center bg-white">
    
    {/* 1. Hero Detalles del Proyecto */}
    <section class="w-full bg-[#132338] pt-32 pb-32 px-8 relative overflow-hidden flex justify-center">
      {/* Crisp Geometric Background Shapes (reusing from Proyectos) */}
      <svg class="absolute inset-0 w-full h-full z-0 pointer-events-none" preserveAspectRatio="xMidYMid slice" viewBox="0 0 1440 600" xmlns="http://www.w3.org/2000/svg">
        <path d="M 120 0 L 750 0 A 400 400 0 0 1 750 700 L -200 700 L -200 180 Z" fill="#233142" opacity="0.8" />
        <circle cx="1100" cy="300" r="500" fill="#0d182b" opacity="0.6" />
      </svg>
      
      <div class="max-w-6xl lg:max-w-300 w-full relative z-10 flex flex-col pt-4">
        <div class="flex items-center space-x-2 text-xs md:text-sm tracking-wide mb-6 text-[#8c96a4] font-bold uppercase">
          <a href="/" class="hover:text-white transition-colors">INICIO</a>
          <span>/</span>
          <a href="/proyectos" class="hover:text-white transition-colors">PROYECTOS</a>
          <span>/</span>
          <a href={`/proyectos/${project.slug}`} class="text-[#e68424] hover:underline">{project.title.toUpperCase()}</a>
        </div>

        <h1 class="text-4xl md:text-6xl lg:text-[5.5rem] font-black leading-[0.95] tracking-tighter uppercase max-w-5xl">
          <span class="text-white">{titlePart1}</span><br/>
          <span class="text-[#e68424]">{titlePart2}</span>
        </h1>
      </div>
    </section>

    {/* 2. Main Content Area */}
    <section class="w-full px-8 flex justify-center py-16 bg-white relative z-20">
      <div class="max-w-6xl lg:max-w-300 w-full flex flex-col lg:flex-row gap-16 lg:gap-24">
        
        {/* Left Column (Article) */}
        <div class="w-full lg:w-[65%] flex flex-col">
          
          <a href="/proyectos" class="inline-flex items-center space-x-2 text-[#121a2f] font-black text-xs tracking-widest uppercase hover:opacity-70 transition-opacity mb-8">
            <ArrowLeft size={16} strokeWidth={3} />
            <span>VOLVER A PROYECTOS</span>
          </a>

          {/* Project Artifact Image Placeholder */}
          <div class={`w-full h-87.5 md:h-112.5 ${project.imagePlaceholderClass} rounded-xl mb-8 flex items-center justify-center`}>
             <span class="text-white/30 text-xs font-bold tracking-widest uppercase text-center select-none">[ PROJECT<br/>ARTIFACT ]</span>
          </div>

          <h2 class="text-3xl md:text-4xl font-black text-[#121a2f] leading-tight mb-4">
            {project.title}
          </h2>

          <h3 class="text-gray-400 text-sm md:text-base leading-relaxed mb-8">
            {project.subtitle}
          </h3>

          <div class="prose max-w-none text-gray-500 text-sm md:text-base leading-relaxed space-y-6">
            <p>{project.description}</p>
          </div>

        </div>

        {/* Right Column (Sidebar / Metrics) */}
        <div class="w-full lg:w-[35%] flex flex-col">
          
          <div class="bg-white border border-gray-100 rounded-3xl p-8 shadow-sm flex flex-col">
            
            <h4 class="text-gray-400 font-bold text-xs tracking-widest uppercase mb-6">OBJETIVOS CLAVE</h4>
            
            <div class="w-full h-px bg-gray-100 mb-6"></div>

            <ul class="flex flex-col space-y-6 mb-12">
              {project.objectives.map(obj => (
                <li class="flex items-start text-sm text-gray-500 leading-relaxed">
                  <span class="text-[#e68424] font-black mr-2 select-none">—</span>
                  <span class="font-medium">{obj}</span>
                </li>
              ))}
            </ul>

            <h4 class="text-gray-400 font-bold text-xs tracking-widest uppercase mb-6">MÉTRICAS DE IMPACTO</h4>
            
            <div class="w-full h-px bg-gray-100 mb-8"></div>

            <div class="grid grid-cols-2 gap-y-10 gap-x-6">
              {project.metrics.map(metric => (
                <div class="flex flex-col">
                  <span class="text-[#121a2f] text-3xl font-black mb-1">{metric.value}</span>
                  <span class="text-gray-400 text-[9px] font-bold tracking-widest uppercase">{metric.label}</span>
                </div>
              ))}
            </div>

          </div>

        </div>

      </div>
    </section>

    {/* 3. CTA Final */}
    <section class="w-full bg-[#f8fafc] py-24 px-8 flex justify-center text-center">
      <div class="max-w-2xl w-full flex flex-col items-center">
        <h2 class="text-3xl md:text-5xl font-black text-[#121a2f] leading-none tracking-tighter uppercase mb-6">
          ¿QUIERES SABER MÁS<br/>DE ESTE PROYECTO?
        </h2>
        <p class="text-gray-500 text-sm md:text-base leading-relaxed mb-10">
          Conversemos sobre la metodología aplicada, los resultados o cómo estructurar una colaboración institucional similar.
        </p>
        <a href="/contacto" class="inline-flex items-center space-x-2 bg-transparent hover:bg-[#121a2f] text-[#121a2f] hover:text-white px-8 py-3 rounded-full font-bold transition-colors text-xs border border-[#121a2f]">
          <span>Consultar sobre este proyecto</span>
          <ArrowRight size={16} strokeWidth={2.5} />
        </a>
      </div>
    </section>

  </main>
  
  <Footer />
</Layout>
