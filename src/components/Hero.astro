---
import { ChevronDown } from "lucide-react";
---

<section
  class="relative w-full min-h-150 h-[90vh] max-h-250 flex items-end justify-center pb-12 md:pb-20 lg:pb-28 overflow-hidden bg-[#132338]"
>
  {/* Capa con efecto multiplicar según guía (#336699 + mix-blend-multiply) */}
  <div class="absolute inset-0 z-0 bg-[#336699]">
    <video
      autoplay
      loop
      muted
      playsinline
      class="w-full h-full object-cover opacity-85 mix-blend-multiply"
    >
      <source src="/assets/Video de fondo.mp4" type="video/mp4" />
    </video>
  </div>

  {/* Capa de viñeta suave para integrar con navbar y secciones contiguas (#132338) */}
  <div
    class="absolute inset-0 bg-linear-to-b from-[#132338]/50 via-transparent to-[#132338]/90 z-10 pointer-events-none"
  >
  </div>

  {/* Contenido principal alineado hacia la parte inferior */}
  <div
    class="relative z-20 text-center px-4 md:px-8 w-full max-w-6xl mx-auto flex flex-col items-center mb-4 md:mb-8"
  >
    <h1
      class="text-6xl md:text-8xl lg:text-[8rem] font-black text-white tracking-tight leading-none font-nunito drop-shadow-lg"
    >
      FyGrad
    </h1>
    <p
      class="text-3xl md:text-5xl lg:text-[3.5rem] text-[#279FAE] font-light mt-2 md:mt-4 tracking-wide font-nunito"
    >
      Science, Published
    </p>

    {/* Chevron Scroll Down Arrow - pegado justo debajo del texto */}
    <div class="mt-3 md:mt-5 animate-bounce">
      <ChevronDown
        size={48}
        className="text-white w-10 h-10 md:w-12 md:h-12 opacity-90"
        strokeWidth={1.8}
      />
    </div>
  </div>
</section>
