---
import pkg from 'lucide-react';
const { ChevronDown } = pkg;
---

<section class="relative w-full h-[calc(100vh-72px)] min-h-[600px] flex flex-col items-center justify-center overflow-hidden">
  {/* Background Image Placeholder / Overlay */}
  <div class="absolute inset-0 bg-[#132338]/80 z-10"></div>
  <div class="absolute inset-0 z-0">
    <video 
      src="/assets/Video de fondo.mp4" 
      autoplay 
      loop 
      muted 
      playsinline
      class="w-full h-full object-cover opacity-60"
    ></video>
  </div>

  {/* Content */}
  <div class="relative z-20 text-center flex flex-col items-center mt-20">
    {/* Magnifying Glass Placeholder */}
    <div class="mb-6 rounded-full w-64 h-64 border-8 border-gray-800 bg-gray-900/50 backdrop-blur-sm flex items-center justify-center overflow-hidden shadow-2xl relative shadow-[0_0_50px_rgba(0,156,166,0.2)]">
        <img 
          src="https://images.unsplash.com/photo-1559757175-5700dde675bc?auto=format&fit=crop&q=80&w=800" 
          alt="Brain in bulb"
          class="w-full h-full object-cover opacity-70"
        />
        {/* Handle of magnifying glass */}
        <div class="absolute -bottom-24 -left-24 w-12 h-48 bg-gray-800 -rotate-45 origin-top"></div>
    </div>
    
    <h1 class="text-7xl md:text-[9rem] lg:text-[11rem] font-black text-white tracking-tighter drop-shadow-2xl leading-none">
      FyGrad
    </h1>
    <p class="text-2xl md:text-4xl lg:text-[2.5rem] text-[#00a2af] font-light mt-0 md:mt-2 tracking-normal">
      science, published
    </p>
  </div>

  {/* Scroll Down Arrow */}
  <div class="absolute bottom-4 md:bottom-8 z-20 animate-bounce">
    <ChevronDown size={80} className="text-white md:w-[96px] md:h-[96px]" strokeWidth={1.2} />
  </div>
</section>
