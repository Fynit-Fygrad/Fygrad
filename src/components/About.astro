---

<section class="relative w-full min-h-[80vh] flex items-center overflow-hidden bg-gray-900">
  {/* Background Image */}
  <div class="absolute inset-0 z-0">
    <img 
      src="/assets/Fondo somos.jpg" 
      alt="Fondo Somos" 
      class="w-full h-full object-cover grayscale mix-blend-luminosity opacity-40"
    />
  </div>
  
  {/* Gradient Overlay for better text readability */}
  <div class="absolute inset-0 bg-linear-to-r from-transparent to-primary/90 z-10"></div>

  {/* Content */}
  <div class="relative z-20 container mx-auto px-8 flex justify-end">
    <div class="max-w-2xl text-right">
      <h2 class="text-8xl md:text-[10rem] font-black text-white leading-none tracking-tighter drop-shadow-xl mb-4 animate-on-scroll">
        SOMOS
      </h2>
      <p class="text-xl text-gray-200 font-light leading-relaxed mb-12 drop-shadow-md animate-on-scroll delay-100">
        un Research Lab de investigación científica aplicada.<br />
        Acompañamos a investigadores y profesionales en la di-<br />
        fusión de conocimiento científico a nivel internacional.
      </p>
      <a href="#" class="text-4xl font-bold text-accent hover:text-accent-light transition-colors flex items-center justify-end">
        conoce más_
      </a>
    </div>
  </div>
</section>
