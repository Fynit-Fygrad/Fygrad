---

<section
  class="relative w-full min-h-[85vh] flex items-center overflow-hidden bg-[linear-gradient(90deg,#ffffff_0%,#8ba6c1_16%,#3f5f80_45%,#15273d_75%)]"
>
  {/* Contenido principal */}
  <div class="relative z-20 container mx-auto px-8 md:px-12 flex justify-end">
    <div class="max-w-xl text-left mr-0 lg:mr-12 py-16">
      <h2
        class="text-5xl md:text-7xl lg:text-[5.5rem] font-black text-white leading-none tracking-tight font-nunito drop-shadow-xl mb-5 animate-on-scroll"
      >
        SOMOS
      </h2>
      <p
        class="text-lg md:text-xl font-light text-white/90 leading-relaxed font-nunito mb-8 drop-shadow-md animate-on-scroll delay-100 max-w-lg"
      >
        Un Research Lab de investigación científica aplicada. Acompañamos a
        investigadores y profesionales en la difusión de conocimiento científico
        a nivel internacional.
      </p>
      <a
        href="/nosotros"
        class="text-2xl md:text-3xl font-bold text-[#00a2af] hover:text-[#00c4d4] transition-colors font-nunito inline-flex items-center gap-2 tracking-normal animate-on-scroll delay-200"
      >
        <span>Conoce más</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-6 h-6 md:w-7 md:h-7"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
