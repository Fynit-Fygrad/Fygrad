---

---

<section
  class="relative w-full min-h-[85vh] flex items-center overflow-hidden bg-[#132338]"
>
  {/* Capa de foto del equipo con efecto multiplicar */}
  <div class="absolute inset-0 z-0 bg-[#336699]">
    <img
      src="/assets/IMAGEN-EQUIPO.jpg"
      alt="Equipo FyGrad"
      class="w-full h-full object-cover object-left-top grayscale mix-blend-multiply opacity-80"
    />
  </div>

  {/* Degradado horizontal: transparente a la izquierda para mostrar la foto, degradando a azul marino a la derecha detrás del texto */}
  <div
    class="absolute inset-0 bg-linear-to-r from-transparent via-[#132338]/60 via-40% to-[#132338] z-10 pointer-events-none"
  >
  </div>

  {/* Contenido principal a la derecha */}
  <div class="relative z-20 container mx-auto px-8 md:px-12 flex justify-end">
    <div class="max-w-xl text-right flex flex-col items-end mr-0 lg:mr-8 py-16">
      <h2
        class="text-5xl md:text-7xl lg:text-[5.5rem] font-black text-white leading-none tracking-tight font-nunito drop-shadow-xl mb-5 animate-on-scroll text-right"
      >
        SOMOS
      </h2>
      <p
        class="text-lg md:text-xl font-light text-white/90 leading-relaxed font-nunito mb-8 drop-shadow-md animate-on-scroll delay-100 max-w-lg text-right"
      >
        un Research Lab de investigación científica aplicada. Acompañamos a
        investigadores y profesionales en la difusión de conocimiento científico
        a nivel internacional.
      </p>
      <a
        href="/nosotros"
        class="text-2xl md:text-3xl font-bold text-[#00a2af] hover:text-[#00c4d4] transition-colors font-nunito inline-flex items-center gap-2 tracking-normal animate-on-scroll delay-200"
      >
        <span>Conoce más</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-6 h-6 md:w-7 md:h-7"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
