---

---

<section
  class="relative w-full min-h-[80vh] flex items-center overflow-hidden bg-gray-900"
>
  {/* Background Image */}
  <div class="absolute inset-0 z-0">
    <img
      src="/assets/Fondo somos.jpg"
      alt="Fondo Somos"
      class="w-full h-full object-cover grayscale mix-blend-luminosity opacity-40"
    />
  </div>

  {/* Gradient Overlay for better text readability */}
  <div
    class="absolute inset-0 bg-linear-to-r from-transparent to-primary/90 z-10"
  >
  </div>

  {/* Content */}
  <div class="relative z-20 container mx-auto px-8 flex justify-end">
    <div class="max-w-2xl text-left mr-0 lg:mr-32">
      <h2
        class="text-4xl sm:text-5xl md:text-[4rem] lg:text-[5rem] font-black text-white leading-none tracking-tighter drop-shadow-xl mb-4 animate-on-scroll"
      >
        SOMOS
      </h2>
      <p
        class="text-xl text-gray-200 font-normal leading-loose mb-12 drop-shadow-md animate-on-scroll delay-100 max-w-lg text-balance"
      >
        Un Research Lab de investigación científica aplicada. Acompañamos a
        investigadores y profesionales en la difusión de conocimiento científico
        a nivel internacional.
      </p>
      <a
        href="#"
        class="text-4xl font-bold text-accent hover:text-accent-light transition-colors flex items-center justify-start gap-2 uppercase"
      >
        CONOCE MÁS <svg
          xmlns="http://www.w3.org/2000/svg"
          width="36"
          height="36"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
        >
      </a>
    </div>
  </div>
</section>
