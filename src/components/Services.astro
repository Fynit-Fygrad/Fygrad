---
---

<section class="w-full bg-[#132338] py-24 px-6 md:px-10 flex justify-center items-center">
  {/* The 8/9 aspect ratio forces exactly the 6-row 2-col staggered masonry layout */}
  <div class="max-w-5xl lg:max-w-6xl w-full grid grid-cols-2 grid-rows-6 gap-3 md:gap-5 lg:gap-6" style="aspect-ratio: 8/9;">
    
    {/* TITLE - Left Col, Row 1 */}
    <div class="col-start-1 row-start-1 row-span-1 flex flex-col justify-end pb-1 md:pb-2">
      <h2 class="text-4xl sm:text-5xl md:text-[4rem] lg:text-[5rem] font-black leading-[0.85] tracking-tighter uppercase">
        <span class="text-[#8c96a4] block font-sans">NUESTROS</span>
        <span class="text-white block italic">SERVICIOS</span>
      </h2>
    </div>

    {/* RESEARCH - Left Col, Row 2-3 */}
    <div class="col-start-1 row-start-2 row-span-2 bg-[#8c949d] w-full h-full p-4 md:p-6 group cursor-pointer hover:bg-[#7b838c] transition-colors">
      <h3 class="text-2xl md:text-3xl lg:text-4xl font-black text-[#e2e8f0]/90 italic uppercase group-hover:text-white transition-colors tracking-tight">RESEARCH</h3>
    </div>
    
    {/* REVIEW - Left Col, Row 4-5 */}
    <div class="col-start-1 row-start-4 row-span-2 bg-[#8c949d] w-full h-full p-4 md:p-6 group cursor-pointer hover:bg-[#7b838c] transition-colors">
      <h3 class="text-2xl md:text-3xl lg:text-4xl font-black text-[#e2e8f0]/90 italic uppercase group-hover:text-white transition-colors tracking-tight">REVIEW</h3>
    </div>
    
    {/* LINK - Left Col, Row 6 */}
    <div class="col-start-1 row-start-6 row-span-1 flex flex-col justify-start pt-2 md:pt-4">
      <p class="text-[0.8rem] sm:text-lg md:text-2xl lg:text-[1.75rem] font-bold uppercase leading-tight text-white mb-0.5 md:mb-1 tracking-tight">CONOCE MÁS DE<br/>NUESTROS SERVICIOS</p>
      <a href="#" class="text-[0.8rem] sm:text-lg md:text-2xl lg:text-[1.75rem] font-black text-[#00a2af] hover:opacity-80 transition-opacity uppercase tracking-wider">
        AQUI_
      </a>
    </div>

    {/* PUBLICATION - Right Col, Row 1-2 */}
    <div class="col-start-2 row-start-1 row-span-2 bg-[#8c949d] w-full h-full p-4 md:p-6 group cursor-pointer hover:bg-[#7b838c] transition-colors">
      <h3 class="text-2xl md:text-3xl lg:text-4xl font-black text-[#e2e8f0]/90 italic uppercase group-hover:text-white transition-colors tracking-tight">PUBLICATION</h3>
    </div>

    {/* ACADEMY - Right Col, Row 3-4 */}
    <div class="col-start-2 row-start-3 row-span-2 bg-[#8c949d] w-full h-full p-4 md:p-6 group cursor-pointer hover:bg-[#7b838c] transition-colors">
      <h3 class="text-2xl md:text-3xl lg:text-4xl font-black text-[#e2e8f0]/90 italic uppercase group-hover:text-white transition-colors tracking-tight">ACADEMY</h3>
    </div>

    {/* DEVELOPMENT LAB - Right Col, Row 5-6 */}
    <div class="col-start-2 row-start-5 row-span-2 bg-[#8c949d] w-full h-full p-4 md:p-6 group cursor-pointer hover:bg-[#7b838c] transition-colors">
      <h3 class="text-2xl md:text-3xl lg:text-4xl font-black text-[#e2e8f0]/90 italic uppercase group-hover:text-white transition-colors leading-[0.9] tracking-tight">DEVELOPMENT<br/>LAB</h3>
    </div>

  </div>
</section>
