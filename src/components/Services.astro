---

---

<section
  class="w-full bg-[#132338] py-24 px-6 md:px-10 flex justify-center items-center"
>
  {
    /* The 8/9 aspect ratio forces exactly the 6-row 2-col staggered masonry layout */
  }
  <div
    class="max-w-5xl lg:max-w-6xl w-full grid grid-cols-2 grid-rows-6 gap-3 md:gap-5 lg:gap-6"
    style="aspect-ratio: 8/9;"
  >
    {/* TITLE - Left Col, Row 1 */}
    <div
      class="col-start-1 row-start-1 row-span-1 flex flex-col justify-end pb-1 md:pb-2 animate-on-scroll"
    >
      <h2
        class="text-4xl sm:text-5xl md:text-[4rem] lg:text-[5rem] font-black leading-none tracking-tight uppercase font-nunito"
      >
        <span class="text-[#8c96a4] block">NUESTROS</span>
        <span class="text-white block italic">SERVICIOS</span>
      </h2>
    </div>

    {/* RESEARCH - Left Col, Row 2-3 */}
    <a
      href="/servicios/fy-prime"
      class="col-start-1 row-start-2 row-span-2 bg-[#233348] relative overflow-hidden rounded-2xl w-full h-full p-4 md:p-6 group cursor-pointer animate-on-scroll delay-100"
    >
      <img
        src="/assets/SERVICIOS/Servicio-RESEARCH.jpg"
        alt="Research"
        class="absolute inset-0 w-full h-full object-cover opacity-40 group-hover:opacity-85 group-hover:scale-105 transition-all duration-700 mix-blend-multiply"
      />
      <div class="absolute inset-0 bg-radial from-transparent via-[#132338]/40 to-[#132338]/80 pointer-events-none"></div>
      <h3
        class="relative z-10 text-2xl md:text-3xl lg:text-4xl font-black text-white italic uppercase font-nunito tracking-tight drop-shadow-lg"
      >
        RESEARCH
      </h3>
    </a>

    {/* REVIEW - Left Col, Row 4-5 */}
    <a
      href="/servicios/fy-review"
      class="col-start-1 row-start-4 row-span-2 bg-[#233348] relative overflow-hidden rounded-2xl w-full h-full p-4 md:p-6 group cursor-pointer animate-on-scroll delay-200"
    >
      <img
        src="/assets/SERVICIOS/SERVICIO-REVIEW.jpg"
        alt="Review"
        class="absolute inset-0 w-full h-full object-cover opacity-40 group-hover:opacity-85 group-hover:scale-105 transition-all duration-700 mix-blend-multiply"
      />
      <div class="absolute inset-0 bg-radial from-transparent via-[#132338]/40 to-[#132338]/80 pointer-events-none"></div>
      <h3
        class="relative z-10 text-2xl md:text-3xl lg:text-4xl font-black text-white italic uppercase font-nunito tracking-tight drop-shadow-lg"
      >
        REVIEW
      </h3>
    </a>

    {/* LINK - Left Col, Row 6 */}
    <div
      class="col-start-1 row-start-6 row-span-1 flex flex-col justify-start pt-2 md:pt-4 animate-on-scroll delay-300 font-nunito"
    >
      <p
        class="text-[0.8rem] sm:text-lg md:text-2xl lg:text-[1.65rem] font-bold uppercase leading-tight text-white mb-0.5 md:mb-1 tracking-tight"
      >
        CONOCE MÁS DE<br />NUESTROS SERVICIOS
      </p>
      <a
        href="/servicios"
        class="text-[0.8rem] sm:text-lg md:text-2xl lg:text-[1.65rem] font-bold text-[#00a2af] hover:text-[#00c4d4] transition-colors uppercase tracking-wider flex items-center gap-1"
      >
        <span>AQUÍ_</span>
      </a>
    </div>

    {/* PUBLICATION - Right Col, Row 1-2 */}
    <a
      href="/servicios/fy-start"
      class="col-start-2 row-start-1 row-span-2 bg-[#233348] relative overflow-hidden rounded-2xl w-full h-full p-4 md:p-6 group cursor-pointer animate-on-scroll delay-200"
    >
      <img
        src="/assets/SERVICIOS/Servicio-PUBLICATION.jpg"
        alt="Publication"
        class="absolute inset-0 w-full h-full object-cover opacity-40 group-hover:opacity-85 group-hover:scale-105 transition-all duration-700 mix-blend-multiply"
      />
      <div class="absolute inset-0 bg-radial from-transparent via-[#132338]/40 to-[#132338]/80 pointer-events-none"></div>
      <h3
        class="relative z-10 text-2xl md:text-3xl lg:text-4xl font-black text-white italic uppercase font-nunito tracking-tight drop-shadow-lg"
      >
        PUBLICATION
      </h3>
    </a>

    {/* ACADEMY - Right Col, Row 3-4 */}
    <a
      href="/servicios/fy-titulacion"
      class="col-start-2 row-start-3 row-span-2 bg-[#233348] relative overflow-hidden rounded-2xl w-full h-full p-4 md:p-6 group cursor-pointer animate-on-scroll delay-300"
    >
      <img
        src="/assets/SERVICIOS/Servicio-ACADEMY.jpg"
        alt="Academy"
        class="absolute inset-0 w-full h-full object-cover opacity-40 group-hover:opacity-85 group-hover:scale-105 transition-all duration-700 mix-blend-multiply"
      />
      <div class="absolute inset-0 bg-radial from-transparent via-[#132338]/40 to-[#132338]/80 pointer-events-none"></div>
      <h3
        class="relative z-10 text-2xl md:text-3xl lg:text-4xl font-black text-white italic uppercase font-nunito tracking-tight drop-shadow-lg"
      >
        ACADEMY
      </h3>
    </a>

    {/* DEVELOPMENT LAB - Right Col, Row 5-6 */}
    <a
      href="/servicios/development-lab"
      class="col-start-2 row-start-5 row-span-2 bg-[#233348] relative overflow-hidden rounded-2xl w-full h-full p-4 md:p-6 group cursor-pointer animate-on-scroll delay-400"
    >
      <img
        src="/assets/SERVICIOS/Servicio-DEVELOPMENT-LAB.jpg"
        alt="Development Lab"
        class="absolute inset-0 w-full h-full object-cover opacity-40 group-hover:opacity-85 group-hover:scale-105 transition-all duration-700 mix-blend-multiply"
      />
      <div class="absolute inset-0 bg-radial from-transparent via-[#132338]/40 to-[#132338]/80 pointer-events-none"></div>
      <h3
        class="relative z-10 text-2xl md:text-3xl lg:text-4xl font-black text-white italic uppercase font-nunito leading-[0.9] tracking-tight drop-shadow-lg"
      >
        DEVELOPMENT<br />LAB
      </h3>
    </a>
  </div>
</section>
