---
import { X, ShoppingCart } from 'lucide-react';
---

<nav class="relative w-full z-40 flex items-center justify-between px-8 md:px-12 py-5 bg-[#132338]">
  <a href="/" class="flex items-center z-50 hover:opacity-80 hover:scale-105 transition-all duration-300">
    <img src="/assets/Logo FyGrad.svg" alt="FyGrad Logo" class="h-10 md:h-12" />
  </a>

  <div class="flex items-center space-x-6 md:space-x-8 z-50">
    <div class="flex items-center space-x-4">
      <a href="/checkout" class="relative text-[#00a2af] hover:text-white hover:scale-110 active:scale-95 transition-all duration-300">
        <ShoppingCart size={24} strokeWidth={2} />
        <span id="cart-badge" class="absolute -top-2 -right-2 bg-[#e63946] text-white text-[10px] font-bold w-5 h-5 flex items-center justify-center rounded-full opacity-0 transition-opacity duration-300">0</span>
      </a>
      <a 
        href="#" 
        class="bg-[#00a2af] hover:bg-[#008f9c] hover:shadow-[0_0_15px_rgba(0,162,175,0.5)] hover:-translate-y-0.5 active:translate-y-0 active:scale-95 transition-all duration-300 text-white font-medium py-1.5 px-4 rounded-full flex items-center space-x-2 text-xs md:text-sm tracking-wide"
      >
        <span>Agenda</span>
        <svg class="w-4 h-4 fill-current text-white shrink-0" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
        </svg>
      </a>
    </div>

    <button id="menu-open" class="flex flex-col justify-between w-8 h-[1.1rem] hover:scale-110 active:scale-95 transition-all duration-300 group">
      <span class="w-full h-0.5 bg-[#00a2af] rounded-full group-hover:bg-white transition-colors"></span>
      <span class="w-full h-0.5 bg-[#00a2af] rounded-full group-hover:bg-white transition-colors"></span>
      <span class="w-full h-0.5 bg-[#00a2af] rounded-full group-hover:bg-white transition-colors"></span>
    </button>
  </div>
</nav>

{/* Mobile Menu Overlay / Sidebar */}
<div 
  id="mobile-menu" 
  class="fixed inset-0 z-100 bg-black/60 opacity-0 pointer-events-none transition-opacity duration-500 backdrop-blur-sm"
>
  {/* Sidebar Container */}
  <div 
    id="sidebar" 
    class="absolute top-0 right-0 w-full sm:w-112.5 md:w-100 h-full bg-[#132338] transform translate-x-full transition-transform duration-500 cubic-bezier(0.4, 0, 0.2, 1) flex flex-col shadow-2xl"
  >
    {/* Sidebar Header */}
    <div class="flex items-center justify-between px-8 md:px-12 py-5 md:py-6">
      
      <a href="/" class="flex items-center hover:opacity-80 hover:scale-105 transition-all duration-300">
        <img src="/assets/Logo FyGrad.svg" alt="FyGrad Logo" class="h-10 md:h-12" />
      </a>

      {/* Close Button */}
      <button id="menu-close" class="flex items-center text-white hover:text-[#00a2af] hover:rotate-90 hover:scale-110 transition-all duration-300 p-2 -mr-2">
        <X size={32} strokeWidth={1.5} />
      </button>
      
    </div>

    {/* Sidebar Links */}
    <div class="flex flex-col px-8 md:px-12 pt-8 grow overflow-y-auto">
      <div class="flex flex-col space-y-6 md:space-y-8" id="sidebar-links-container">
        <a href="/nosotros" class="sidebar-link opacity-0 translate-y-8 text-[1.75rem] md:text-[2rem] leading-none font-black text-[#cbd5e1] hover:text-[#00a2af] hover:translate-x-2 transition-all duration-300 uppercase tracking-wide">NOSOTROS</a>
        <a href="/servicios" class="sidebar-link opacity-0 translate-y-8 text-[1.75rem] md:text-[2rem] leading-none font-black text-[#cbd5e1] hover:text-[#00a2af] hover:translate-x-2 transition-all duration-300 uppercase tracking-wide">SERVICIOS</a>
        <a href="/proyectos" class="sidebar-link opacity-0 translate-y-8 text-[1.75rem] md:text-[2rem] leading-none font-black text-[#cbd5e1] hover:text-[#00a2af] hover:translate-x-2 transition-all duration-300 uppercase tracking-wide">PROYECTOS</a>
        <a href="/equipo" class="sidebar-link opacity-0 translate-y-8 text-[1.75rem] md:text-[2rem] leading-none font-black text-[#cbd5e1] hover:text-[#00a2af] hover:translate-x-2 transition-all duration-300 uppercase tracking-wide">EQUIPO</a>
        <a href="/ecosistema" class="sidebar-link opacity-0 translate-y-8 text-[1.75rem] md:text-[2rem] leading-none font-black text-[#cbd5e1] hover:text-[#00a2af] hover:translate-x-2 transition-all duration-300 uppercase tracking-wide">ECOSISTEMA</a>
        <a href="/blog" class="sidebar-link opacity-0 translate-y-8 text-[1.75rem] md:text-[2rem] leading-none font-black text-[#cbd5e1] hover:text-[#00a2af] hover:translate-x-2 transition-all duration-300 uppercase tracking-wide">BLOG</a>
        <a href="/contacto" class="sidebar-link opacity-0 translate-y-8 text-[1.75rem] md:text-[2rem] leading-none font-black text-[#cbd5e1] hover:text-[#00a2af] hover:translate-x-2 transition-all duration-300 uppercase tracking-wide">CONTÁCTANOS</a>
      </div>
      
      {/* Bottom Social Links */}
      <div class="mt-auto pb-8 pt-12 sidebar-footer opacity-0 translate-y-8 transition-all duration-500">
        <div class="w-full h-px bg-white/10 mb-6"></div>
        <div class="flex items-center space-x-6 md:space-x-8">
          <a href="#" class="text-sm text-gray-title hover:text-white hover:-translate-y-1 transition-all duration-300">Facebook</a>
          <a href="#" class="text-sm text-gray-title hover:text-white hover:-translate-y-1 transition-all duration-300">Instagram</a>
          <a href="#" class="text-sm text-gray-title hover:text-white hover:-translate-y-1 transition-all duration-300">LinkedIn</a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const menuOpen = document.getElementById('menu-open');
  const menuClose = document.getElementById('menu-close');
  const mobileMenu = document.getElementById('mobile-menu');
  const sidebar = document.getElementById('sidebar');
  const sidebarLinks = document.querySelectorAll('.sidebar-link');
  const sidebarFooter = document.querySelector('.sidebar-footer');

  if (menuOpen && menuClose && mobileMenu && sidebar) {
    // Función para cerrar el menú
    const closeMenu = () => {
      mobileMenu.classList.add('opacity-0', 'pointer-events-none');
      sidebar.classList.add('translate-x-full');
      
      // Reset animations
      sidebarLinks.forEach(link => {
        link.classList.remove('opacity-100', 'translate-y-0');
        link.classList.add('opacity-0', 'translate-y-8');
      });
      if(sidebarFooter) {
        sidebarFooter.classList.remove('opacity-100', 'translate-y-0');
        sidebarFooter.classList.add('opacity-0', 'translate-y-8');
      }
    };

    menuOpen.addEventListener('click', () => {
      mobileMenu.classList.remove('opacity-0', 'pointer-events-none');
      sidebar.classList.remove('translate-x-full');

      // Staggered animation for links
      sidebarLinks.forEach((link, index) => {
        setTimeout(() => {
          link.classList.remove('opacity-0', 'translate-y-8');
          link.classList.add('opacity-100', 'translate-y-0');
        }, 300 + (index * 80)); // Empieza después de que el sidebar comience a deslizarse
      });

      // Animate footer
      if(sidebarFooter) {
        setTimeout(() => {
          sidebarFooter.classList.remove('opacity-0', 'translate-y-8');
          sidebarFooter.classList.add('opacity-100', 'translate-y-0');
        }, 300 + (sidebarLinks.length * 80));
      }
    });

    menuClose.addEventListener('click', closeMenu);

    mobileMenu.addEventListener('click', (e) => {
      if (e.target === mobileMenu) {
        closeMenu();
      }
    });

    // Cerrar el menú automáticamente al hacer clic en un enlace
    sidebarLinks.forEach(link => {
      link.addEventListener('click', closeMenu);
    });
  }

  // Cart Badge Logic
  const updateCartBadge = () => {
    const cartBadge = document.getElementById('cart-badge');
    if (!cartBadge) return;
    
    const cart = JSON.parse(localStorage.getItem('fygrad_cart') || '[]');
    const count = cart.length;
    
    cartBadge.textContent = count;
    if (count > 0) {
      cartBadge.classList.remove('opacity-0');
      cartBadge.classList.add('opacity-100');
    } else {
      cartBadge.classList.remove('opacity-100');
      cartBadge.classList.add('opacity-0');
    }
  };

  // Update on load
  updateCartBadge();
  
  // Listen for custom events from other components (like Add to Cart)
  document.addEventListener('cart-updated', updateCartBadge);

</script>
