---

---

<section class="w-full bg-white py-24 px-8 flex justify-center">
  <div class="max-w-5xl w-full flex flex-col items-center md:items-start">
    
    <div class="w-full text-left mb-16 animate-on-scroll">
      <h2 class="text-6xl md:text-8xl font-black leading-none tracking-tighter uppercase">
        <span class="text-gray-title block italic">ECOSISTEMA</span>
        <span class="text-primary block italic">ACADÉMICO</span>
      </h2>
    </div>

    <div class="w-full flex flex-wrap justify-start items-center gap-6 md:gap-8 lg:gap-10 animate-on-scroll delay-200">
      <div class="flex items-center gap-2 opacity-80 hover:opacity-100 transition-opacity cursor-pointer">
        <img src="/assets/Scopus.svg" alt="Scopus" class="h-10 md:h-14 object-contain w-auto"/>
      </div>
      
      <div class="flex items-center gap-2 opacity-80 hover:opacity-100 transition-opacity cursor-pointer">
        <img src="/assets/Scielo.svg" alt="SciELO" class="h-10 md:h-14 object-contain w-auto"/>
      </div>
      
      <div class="flex items-center gap-2 opacity-80 hover:opacity-100 transition-opacity cursor-pointer">
        <img src="/assets/IEEE.svg" alt="IEEE" class="h-8 md:h-10 object-contain w-auto"/>
      </div>
      
      <div class="flex items-center gap-2 opacity-80 hover:opacity-100 transition-opacity cursor-pointer">
        <img src="/assets/ACM.svg" alt="ACM" class="h-12 md:h-16 object-contain w-auto"/>
      </div>
      
      <div class="flex items-center gap-2 opacity-80 hover:opacity-100 transition-opacity cursor-pointer">
         <img src="/assets/Springer.svg" alt="Springer" class="h-8 md:h-10 object-contain w-auto"/>
      </div>
    </div>
    
    {/* Map and Universities Section */}
    <div class="w-full mt-24 rounded-[2.5rem] overflow-hidden bg-linear-to-br from-[#4a0072] to-[#290042] p-8 md:p-14 text-white relative flex flex-col md:flex-row items-center justify-between shadow-2xl animate-on-scroll">
      
      {/* Network Background Pattern (CSS based placeholder) */}
      <div class="absolute inset-0 opacity-20 bg-[radial-gradient(ellipse_at_center,var(--tw-gradient-stops))] from-white/20 via-transparent to-transparent pointer-events-none"></div>
      
      {/* Left Content */}
      <div class="relative z-10 flex flex-col items-start space-y-10 w-full md:w-1/2">
        
        <div class="space-y-4">
          <div class="flex items-center gap-4">
            <span class="text-2xl">🎓</span>
            <h3 class="text-xl md:text-[1.75rem] font-bold tracking-wide">Todas las Carreras</h3>
          </div>
          <div class="flex items-center gap-4">
            <span class="text-2xl">🎓</span>
            <h3 class="text-xl md:text-[1.75rem] font-bold tracking-wide">Todas las Universidades</h3>
          </div>
          <div class="flex items-center gap-4">
            <span class="text-2xl">🎓</span>
            <h3 class="text-xl md:text-[1.75rem] font-bold tracking-wide">Maestrías y Doctorados</h3>
          </div>
        </div>

        <div class="flex gap-4 flex-wrap">
          {/* University Logos Placeholders */}
          <div class="bg-white/10 p-3 rounded-lg backdrop-blur-sm border border-white/20 w-32 h-16 flex items-center justify-center hover:bg-white/20 transition-colors cursor-pointer">
            <span class="text-xs font-bold text-center">UPC</span>
          </div>
          <div class="bg-white/10 p-3 rounded-lg backdrop-blur-sm border border-white/20 w-32 h-16 flex items-center justify-center hover:bg-white/20 transition-colors cursor-pointer">
            <span class="text-xs font-bold text-center">Cayetano Heredia</span>
          </div>
          <div class="bg-white/10 p-3 rounded-lg backdrop-blur-sm border border-white/20 w-32 h-16 flex items-center justify-center hover:bg-white/20 transition-colors cursor-pointer">
            <span class="text-xs font-bold text-center">U. Pacífico</span>
          </div>
        </div>
        
        <p class="text-2xl md:text-[2rem] font-bold mt-8 tracking-tight">¡Titúlate desde donde estes!</p>
      </div>

      {/* Right Content: Map Placeholder */}
      <div class="relative z-10 w-full md:w-1/2 flex justify-center mt-12 md:mt-0">
        <div class="w-64 md:w-80 h-96 bg-[#d926a9]/20 border-2 border-[#d926a9]/50 rounded-4xl flex flex-col items-center justify-center backdrop-blur-sm shadow-[0_0_60px_rgba(217,38,169,0.3)] p-6">
           <span class="text-center font-bold text-lg">Mapa del Perú</span>
           <span class="text-center text-sm opacity-80 mt-2">(Reemplazar con la imagen del mapa de la referencia)</span>
        </div>
      </div>
      
    </div>

  </div>
</section>
