<section class="w-full bg-white py-24 px-8 flex justify-center">
  <div class="max-w-5xl w-full flex flex-col items-center md:items-start">
    
    <div class="w-full text-left mb-16">
      <h2 class="text-6xl md:text-8xl font-black leading-none tracking-tighter uppercase">
        <span class="text-gray-title block italic">ECOSISTEMA</span>
        <span class="text-primary block italic">ACADÉMICO</span>
      </h2>
    </div>

    <div class="w-full flex flex-wrap justify-start items-center gap-12 md:gap-16">
      {/* Emulating the orange tint using CSS filters for the placeholders */}
      <div class="flex items-center gap-2 sepia-[1] hue-rotate-[-30deg] saturate-[3] opacity-80 hover:opacity-100 transition-all cursor-pointer">
        <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/2/26/Scopus_logo.svg/512px-Scopus_logo.svg.png" alt="Scopus" class="h-10 object-contain"/>
      </div>
      
      <div class="flex items-center gap-2 sepia-[1] hue-rotate-[-30deg] saturate-[3] opacity-80 hover:opacity-100 transition-all cursor-pointer">
        <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/7/74/SciELO_logo.svg/512px-SciELO_logo.svg.png" alt="SciELO" class="h-10 object-contain"/>
      </div>
      
      <div class="flex items-center gap-2 sepia-[1] hue-rotate-[-30deg] saturate-[3] opacity-80 hover:opacity-100 transition-all cursor-pointer">
        <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/2/21/IEEE_logo.svg/512px-IEEE_logo.svg.png" alt="IEEE" class="h-8 object-contain"/>
      </div>
      
      <div class="flex items-center gap-2 sepia-[1] hue-rotate-[-30deg] saturate-[3] opacity-80 hover:opacity-100 transition-all cursor-pointer">
        <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/8/8e/Association_for_Computing_Machinery_%28ACM%29_logo.svg/512px-Association_for_Computing_Machinery_%28ACM%29_logo.svg.png" alt="ACM" class="h-12 object-contain"/>
      </div>
      
      <div class="flex items-center gap-2 sepia-[1] hue-rotate-[-30deg] saturate-[3] opacity-80 hover:opacity-100 transition-all cursor-pointer">
         <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/0/01/Springer_logo.svg/512px-Springer_logo.svg.png" alt="Springer" class="h-8 object-contain"/>
      </div>
    </div>
    
  </div>
</section>
