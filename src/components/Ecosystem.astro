---
import { Image } from 'astro:assets';
import scopusLogo from '../assets/Scopus.svg';
import scieloLogo from '../assets/Scielo.svg';
import ieeeLogo from '../assets/IEEE.svg';
import acmLogo from '../assets/ACM.svg';
import springerLogo from '../assets/Springer.svg';
---

<section class="w-full bg-white py-24 px-8 flex justify-center">
  <div class="max-w-5xl w-full flex flex-col items-center md:items-start">
    
    <div class="w-full text-left mb-16 animate-on-scroll">
      <h2 class="text-6xl md:text-8xl font-black leading-none tracking-tighter uppercase">
        <span class="text-gray-title block italic">ECOSISTEMA</span>
        <span class="text-primary block italic">ACADÉMICO</span>
      </h2>
    </div>

    <div class="w-full flex flex-wrap justify-start items-center gap-6 md:gap-8 lg:gap-10 animate-on-scroll delay-200">
      <div class="flex items-center gap-2 opacity-80 hover:opacity-100 transition-opacity cursor-pointer">
        <Image src={scopusLogo} alt="Scopus" class="h-10 md:h-14 object-contain w-auto"/>
      </div>
      
      <div class="flex items-center gap-2 opacity-80 hover:opacity-100 transition-opacity cursor-pointer">
        <Image src={scieloLogo} alt="SciELO" class="h-10 md:h-14 object-contain w-auto"/>
      </div>
      
      <div class="flex items-center gap-2 opacity-80 hover:opacity-100 transition-opacity cursor-pointer">
        <Image src={ieeeLogo} alt="IEEE" class="h-8 md:h-10 object-contain w-auto"/>
      </div>
      
      <div class="flex items-center gap-2 opacity-80 hover:opacity-100 transition-opacity cursor-pointer">
        <Image src={acmLogo} alt="ACM" class="h-12 md:h-16 object-contain w-auto"/>
      </div>
      
      <div class="flex items-center gap-2 opacity-80 hover:opacity-100 transition-opacity cursor-pointer">
         <Image src={springerLogo} alt="Springer" class="h-8 md:h-10 object-contain w-auto"/>
      </div>
    </div>
    
  </div>
</section>
