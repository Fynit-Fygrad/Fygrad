---
import { Image } from 'astro:assets';
import scopusLogo from '../assets/Scopus.svg';
import scieloLogo from '../assets/Scielo.svg';
import ieeeLogo from '../assets/IEEE.svg';
import acmLogo from '../assets/ACM.svg';
import springerLogo from '../assets/Springer.svg';
---

<section class="w-full bg-[#132338] py-20 px-8 flex justify-center border-t border-white/5">
  <div class="max-w-5xl lg:max-w-6xl w-full flex flex-col items-center">
    
    {/* ECOSISTEMA ACADÉMICO */}
    <div class="w-full text-center md:text-left mb-12 animate-on-scroll font-nunito">
      <h2 class="text-5xl md:text-7xl lg:text-[5.5rem] font-black leading-none tracking-tight uppercase">
        <span class="text-[#8c96a4] block">ECOSISTEMA</span>
        <span class="text-white block italic">ACADÉMICO</span>
      </h2>
    </div>

    {/* Centered Logos Carousel Container */}
    <div class="w-full bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 flex justify-center items-center mb-24 animate-on-scroll delay-100">
      <div class="flex flex-wrap justify-center items-center gap-8 md:gap-14 lg:gap-16 w-full max-w-4xl">
        <div class="flex items-center opacity-85 hover:opacity-100 transition-opacity cursor-pointer">
          <Image src={scopusLogo} alt="Scopus" class="h-8 md:h-12 object-contain w-auto"/>
        </div>
        
        <div class="flex items-center opacity-85 hover:opacity-100 transition-opacity cursor-pointer">
          <Image src={scieloLogo} alt="SciELO" class="h-8 md:h-12 object-contain w-auto"/>
        </div>
        
        <div class="flex items-center opacity-85 hover:opacity-100 transition-opacity cursor-pointer">
          <Image src={ieeeLogo} alt="IEEE" class="h-6 md:h-10 object-contain w-auto"/>
        </div>
        
        <div class="flex items-center opacity-85 hover:opacity-100 transition-opacity cursor-pointer">
          <Image src={acmLogo} alt="ACM" class="h-10 md:h-14 object-contain w-auto"/>
        </div>
        
        <div class="flex items-center opacity-85 hover:opacity-100 transition-opacity cursor-pointer">
          <Image src={springerLogo} alt="Springer" class="h-7 md:h-10 object-contain w-auto"/>
        </div>
      </div>
    </div>
    
    {/* LO QUE YA LOGRAMOS Section */}
    <div class="w-full pt-8 flex flex-col items-start font-nunito">
      <div class="w-full text-left mb-12 animate-on-scroll">
        <h2 class="text-5xl md:text-7xl lg:text-[5.5rem] font-black leading-none tracking-tight uppercase">
          <span class="text-[#8c96a4] block">LO QUE YA</span>
          <span class="text-white block italic">LOGRAMOS</span>
        </h2>
      </div>

      <div class="w-full grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-0 divide-y-0 md:divide-x divide-white/10 animate-on-scroll delay-200">
        {/* Metric 1 */}
        <div class="flex flex-col items-center md:items-center text-center p-4 md:px-6">
          <span class="text-5xl md:text-7xl lg:text-8xl font-black text-[#00a2af] mb-2 tracking-tight">3</span>
          <span class="text-xs md:text-sm font-bold text-gray-300 uppercase tracking-wide leading-tight max-w-35">
            Años de trayectoria
          </span>
        </div>

        {/* Metric 2 */}
        <div class="flex flex-col items-center md:items-center text-center p-4 md:px-6">
          <span class="text-5xl md:text-7xl lg:text-8xl font-black text-[#00a2af] mb-2 tracking-tight">120+</span>
          <span class="text-xs md:text-sm font-bold text-gray-300 uppercase tracking-wide leading-tight max-w-35">
            Investigaciones publicadas
          </span>
        </div>

        {/* Metric 3 */}
        <div class="flex flex-col items-center md:items-center text-center p-4 md:px-6">
          <span class="text-5xl md:text-7xl lg:text-8xl font-black text-[#00a2af] mb-2 tracking-tight">20+</span>
          <span class="text-xs md:text-sm font-bold text-gray-300 uppercase tracking-wide leading-tight max-w-35">
            Expertos en investigación
          </span>
        </div>

        {/* Metric 4 */}
        <div class="flex flex-col items-center md:items-center text-center p-4 md:px-6">
          <span class="text-5xl md:text-7xl lg:text-8xl font-black text-[#00a2af] mb-2 tracking-tight">4</span>
          <span class="text-xs md:text-sm font-bold text-gray-300 uppercase tracking-wide leading-tight max-w-35">
            Presencia en países
          </span>
        </div>
      </div>
    </div>

  </div>
</section>
