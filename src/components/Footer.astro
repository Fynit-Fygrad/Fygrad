---
import { FaFacebookF, FaInstagram, FaYoutube, FaTiktok, FaLinkedinIn, FaWhatsapp } from 'react-icons/fa';
import { FaXTwitter } from 'react-icons/fa6';
---

<footer class="w-full bg-white pt-24 pb-16 px-8 flex flex-col items-center">
  <div class="max-w-6xl lg:max-w-[75rem] w-full">
    
    {/* Top Section: 3 Columns */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-16 md:gap-8 mb-20">
      
      {/* Column 1: Trabaja con nosotros */}
      <div class="flex flex-col justify-between items-start h-full">
        <h2 class="text-[2.5rem] lg:text-[3.5rem] font-black uppercase leading-[0.85] tracking-tighter">
          <span class="text-[#8994a0] block font-sans">TRABAJA CON</span>
          <span class="text-[#121a2f] block italic">NOSOTROS</span>
        </h2>
        <a href="#" class="text-3xl lg:text-4xl font-bold text-[#e68424] hover:opacity-80 transition-opacity lowercase mt-12 md:mt-0">
          contáctanos_
        </a>
      </div>

      {/* Column 2: Blog Suscribirse */}
      <div class="flex flex-col justify-between items-center text-center h-full">
        <h2 class="text-[2.5rem] lg:text-[3.5rem] font-black uppercase leading-[0.85] tracking-tighter text-[#121a2f]">
          <span class="block italic">BLOG</span>
          <span class="block">SUSCRIBIRSE</span>
        </h2>
        
        <div class="flex items-center mt-12 md:mt-0">
          <span class="text-3xl lg:text-4xl font-black text-[#121a2f] tracking-tighter mr-1">______</span>
          <button class="text-3xl lg:text-4xl font-bold text-[#e68424] hover:opacity-80 transition-opacity lowercase">
            enviar_
          </button>
        </div>
      </div>

      {/* Column 3: Links */}
      <div class="flex flex-col justify-end items-end text-right h-full">
        <nav class="flex flex-col gap-0 text-[#3ba5a9]">
          <a href="#" class="text-2xl lg:text-[1.75rem] font-bold hover:text-[#121a2f] transition-colors uppercase tracking-tight leading-tight">NOSOTROS</a>
          <a href="#" class="text-2xl lg:text-[1.75rem] font-bold hover:text-[#121a2f] transition-colors uppercase tracking-tight leading-tight">SERVICIOS</a>
          <a href="#" class="text-2xl lg:text-[1.75rem] font-bold hover:text-[#121a2f] transition-colors uppercase tracking-tight leading-tight">PROYECTOS</a>
          <a href="#" class="text-2xl lg:text-[1.75rem] font-bold hover:text-[#121a2f] transition-colors uppercase tracking-tight leading-tight">ECOSISTEMA</a>
          <a href="#" class="text-2xl lg:text-[1.75rem] font-bold hover:text-[#121a2f] transition-colors uppercase tracking-tight leading-tight">BLOG</a>
          <a href="#" class="text-2xl lg:text-[1.75rem] font-bold hover:text-[#121a2f] transition-colors uppercase tracking-tight leading-tight">CONTÁCTANOS</a>
        </nav>
      </div>

    </div>

    {/* Bottom Section: Socials & Agenda */}
    <div class="flex flex-col items-center w-full">
      <div class="flex items-center gap-6 lg:gap-8 mb-8">
        <a href="#" class="hover:opacity-80 transition-opacity"><img src="/assets/Logo Facebook.svg" alt="Facebook" class="h-7" /></a>
        <a href="#" class="hover:opacity-80 transition-opacity"><img src="/assets/Logo Intagram.svg" alt="Instagram" class="h-7" /></a>
        <a href="#" class="hover:opacity-80 transition-opacity"><img src="/assets/Logo YouTube.svg" alt="YouTube" class="h-7" /></a>
        <a href="#" class="hover:opacity-80 transition-opacity"><img src="/assets/Logo Twitter.svg" alt="X/Twitter" class="h-7" /></a>
        <a href="#" class="hover:opacity-80 transition-opacity"><img src="/assets/Logo TikTok.svg" alt="TikTok" class="h-7" /></a>
        <a href="#" class="hover:opacity-80 transition-opacity"><img src="/assets/Logo Linkedin.svg" alt="LinkedIn" class="h-7" /></a>
      </div>

      <a 
        href="#" 
        class="bg-[#3ba5a9] hover:bg-[#2e888b] transition-colors text-white font-bold py-2 px-8 rounded-full flex items-center gap-2 text-lg"
      >
        <span>Agenda</span>
        <FaWhatsapp size={22} />
      </a>
    </div>

  </div>
</footer>
