---
import { FaWhatsapp } from 'react-icons/fa';
---

<footer class="w-full bg-white pt-24 pb-16 px-8 flex flex-col items-center font-nunito">
  <div class="max-w-6xl lg:max-w-300 w-full">
    
    {/* Top Section: 3 Columns */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 lg:gap-20 mb-16 items-start">
      
      {/* Column 1: Trabaja con nosotros */}
      <div class="flex flex-col items-center md:items-start text-center md:text-left">
        <h2 class="text-3xl lg:text-[2.5rem] font-black uppercase leading-tight tracking-tight mb-6">
          <span class="text-[#8994a0] block">TRABAJA CON</span>
          <span class="text-[#121a2f] block">NOSOTROS</span>
        </h2>
        <a href="/contacto" class="text-xl lg:text-2xl font-bold text-[#e68424] hover:opacity-80 transition-opacity">
          contáctanos_
        </a>
      </div>

      {/* Column 2: Blog / Suscribirse */}
      <div class="flex flex-col items-center md:items-start text-center md:text-left">
        <h2 class="text-3xl lg:text-[2.5rem] font-black uppercase leading-tight tracking-tight text-[#121a2f] mb-6">
          <span class="block">BLOG</span>
          <span class="block">SUSCRIBIRSE</span>
        </h2>
        <a href="/blog" class="text-xl lg:text-2xl font-bold text-[#e68424] hover:opacity-80 transition-opacity">
          enviar_
        </a>
      </div>

      {/* Column 3: Navigation Links */}
      <div class="flex flex-col items-center md:items-end text-center md:text-right">
        <nav class="flex flex-col gap-1.5 text-[#00a2af]">
          <a href="/nosotros" class="text-lg lg:text-[1.5rem] font-bold hover:text-[#121a2f] transition-colors uppercase tracking-tight leading-tight">NOSOTROS</a>
          <a href="/servicios" class="text-lg lg:text-[1.5rem] font-bold hover:text-[#121a2f] transition-colors uppercase tracking-tight leading-tight">SERVICIOS</a>
          <a href="/proyectos" class="text-lg lg:text-[1.5rem] font-bold hover:text-[#121a2f] transition-colors uppercase tracking-tight leading-tight">PROYECTOS</a>
          <a href="/ecosistema" class="text-lg lg:text-[1.5rem] font-bold hover:text-[#121a2f] transition-colors uppercase tracking-tight leading-tight">ECOSISTEMA</a>
          <a href="/blog" class="text-lg lg:text-[1.5rem] font-bold hover:text-[#121a2f] transition-colors uppercase tracking-tight leading-tight">BLOG</a>
          <a href="/contacto" class="text-lg lg:text-[1.5rem] font-bold hover:text-[#121a2f] transition-colors uppercase tracking-tight leading-tight">CONTÁCTANOS</a>
        </nav>
      </div>

    </div>

    {/* Bottom Section: Socials & Agenda */}
    <div class="flex flex-col items-center w-full pt-6 border-t border-gray-100">
      <div class="flex items-center gap-6 lg:gap-8 mb-6">
        <a href="https://www.facebook.com/share/1E453gugtm/" target="_blank" rel="noopener noreferrer" class="hover:opacity-80 transition-opacity"><img src="/assets/Logo Facebook.svg" alt="Facebook" class="h-6" /></a>
        <a href="https://www.instagram.com/fygrad?igsh=bGJwMXliNTkzYzd0" target="_blank" rel="noopener noreferrer" class="hover:opacity-80 transition-opacity"><img src="/assets/Logo Intagram.svg" alt="Instagram" class="h-6" /></a>
        <a href="https://www.tiktok.com/@fygrad?_r=1&_t=ZS-98fNUlH5lUC" target="_blank" rel="noopener noreferrer" class="hover:opacity-80 transition-opacity"><img src="/assets/Logo TikTok.svg" alt="TikTok" class="h-6" /></a>
        <a href="https://pe.linkedin.com/in/fygrad-205761345?utm_source=share&utm_medium=member_mweb&utm_campaign=share_via&utm_content=profile" target="_blank" rel="noopener noreferrer" class="hover:opacity-80 transition-opacity"><img src="/assets/Logo Linkedin.svg" alt="LinkedIn" class="h-6" /></a>
      </div>

      <a 
        href="https://wa.me/51993963190?text=Hola%20Fygrad%2C%20necesito%20m%C3%A1s%20informaci%C3%B3n." target="_blank" rel="noopener noreferrer"
        class="bg-[#00a2af] hover:bg-[#008f9c] transition-colors text-white font-bold py-2 px-8 rounded-full flex items-center gap-2 text-base md:text-lg shadow-md"
      >
        <span>Agenda aquí</span>
        <FaWhatsapp size={20} />
      </a>
    </div>

  </div>
</footer>
