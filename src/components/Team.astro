---

---

<section class="w-full bg-[#132338] py-24 px-6 md:px-12 flex justify-center">
  <div class="max-w-5xl lg:max-w-6xl w-full flex flex-col items-center">
    <div class="w-full text-left mb-6 md:mb-10 animate-on-scroll">
      <h2
        class="text-5xl md:text-[5rem] lg:text-[6rem] font-black text-white italic uppercase tracking-tight"
      >
        EQUIPO
      </h2>
    </div>

    {/* Team Grid */}
    <div
      class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-0 w-full mx-auto shadow-2xl"
    >
      {/* Box 1 */}
      <div class="aspect-4/3 relative group overflow-hidden bg-[#e5e5e5] animate-on-scroll delay-100">
        <img src="/assets/EQUIPO/ABIGAIL.png" alt="Abigail" class="w-full h-full object-cover grayscale transition-transform duration-500 group-hover:scale-105" />
        <span class="absolute bottom-6 left-0 w-full text-center text-3xl md:text-4xl font-black text-[#ff5a1f] uppercase tracking-widest drop-shadow-sm z-10">ABIGAIL</span>
      </div>
      {/* Box 2 */}
      <div class="aspect-4/3 relative group overflow-hidden bg-[#e5e5e5] animate-on-scroll delay-200">
        <img src="/assets/EQUIPO/ALEX.png" alt="Alex" class="w-full h-full object-cover grayscale transition-transform duration-500 group-hover:scale-105" />
        <span class="absolute bottom-6 left-0 w-full text-center text-3xl md:text-4xl font-black text-[#ff5a1f] uppercase tracking-widest drop-shadow-sm z-10">ALEX</span>
      </div>
      {/* Box 3 */}
      <div class="aspect-4/3 relative group overflow-hidden bg-[#e5e5e5] animate-on-scroll delay-300">
        <img src="/assets/EQUIPO/XIOMARA.png" alt="Xiomara" class="w-full h-full object-cover grayscale transition-transform duration-500 group-hover:scale-105" />
        <span class="absolute bottom-6 left-0 w-full text-center text-3xl md:text-4xl font-black text-[#ff5a1f] uppercase tracking-widest drop-shadow-sm z-10">XIOMARA</span>
      </div>
      {/* Box 4 */}
      <div class="aspect-4/3 relative group overflow-hidden bg-[#e5e5e5] animate-on-scroll delay-100">
        <img src="/assets/EQUIPO/SANDRA.png" alt="Sandra" class="w-full h-full object-cover grayscale transition-transform duration-500 group-hover:scale-105" />
        <span class="absolute bottom-6 left-0 w-full text-center text-3xl md:text-4xl font-black text-[#ff5a1f] uppercase tracking-widest drop-shadow-sm z-10">SANDRA</span>
      </div>
      {/* Box 5 */}
      <div class="aspect-4/3 relative group overflow-hidden bg-[#e5e5e5] animate-on-scroll delay-200">
        <img src="/assets/EQUIPO/SELENI.png" alt="Seleni" class="w-full h-full object-cover grayscale transition-transform duration-500 group-hover:scale-105" />
        <span class="absolute bottom-6 left-0 w-full text-center text-3xl md:text-4xl font-black text-[#ff5a1f] uppercase tracking-widest drop-shadow-sm z-10">SELENI</span>
      </div>
      {/* Box 6 */}
      <div class="aspect-4/3 relative group overflow-hidden bg-[#e5e5e5] animate-on-scroll delay-300">
        <img src="/assets/EQUIPO/SEBASTIAN.png" alt="Sebas" class="w-full h-full object-cover grayscale transition-transform duration-500 group-hover:scale-105" />
        <span class="absolute bottom-6 left-0 w-full text-center text-3xl md:text-4xl font-black text-[#ff5a1f] uppercase tracking-widest drop-shadow-sm z-10">SEBAS</span>
      </div>
    </div>

    <div
      class="w-full mx-auto mt-6 md:mt-8 text-right animate-on-scroll delay-400"
    >
      <a
        href="/equipo"
        class="text-lg md:text-2xl font-bold uppercase text-white leading-tight hover:opacity-80 transition-opacity inline-block"
      >
        NUESTRO EQUIPO<br />
        COMPLETO
        <span class="text-[#00a2af] inline-flex items-center gap-1 ml-1.5">
          AQUÍ
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>
