---
---

<section class="w-full bg-[#132338] py-24 px-6 md:px-12 flex justify-center">
  <div class="max-w-5xl lg:max-w-6xl w-full flex flex-col items-center">
    
    <div class="w-full text-left mb-6 md:mb-10">
      <h2 class="text-5xl md:text-[5rem] lg:text-[6rem] font-black text-white italic uppercase tracking-tight">
        EQUIPO
      </h2>
    </div>

    {/* Team Grid */}
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-0 w-full mx-auto shadow-2xl">
      {/* Box 1 (Top Left) */}
      <div class="aspect-[4/3] bg-[#344050] hover:bg-[#2c3545] transition-colors cursor-pointer"></div>
      {/* Box 2 (Top Mid) */}
      <div class="aspect-[4/3] bg-[#455163] hover:bg-[#3b465a] transition-colors cursor-pointer"></div>
      {/* Box 3 (Top Right) */}
      <div class="aspect-[4/3] bg-[#344050] hover:bg-[#2c3545] transition-colors cursor-pointer"></div>
      
      {/* Box 4 (Bot Left) */}
      <div class="aspect-[4/3] bg-[#455163] hover:bg-[#3b465a] transition-colors cursor-pointer"></div>
      {/* Box 5 (Bot Mid) */}
      <div class="aspect-[4/3] bg-[#344050] hover:bg-[#2c3545] transition-colors cursor-pointer"></div>
      {/* Box 6 (Bot Right) */}
      <div class="aspect-[4/3] bg-[#455163] hover:bg-[#3b465a] transition-colors cursor-pointer"></div>
    </div>

    <div class="w-full mx-auto mt-6 md:mt-8 text-right">
      <a href="#" class="text-lg md:text-2xl font-bold uppercase text-white leading-tight hover:opacity-80 transition-opacity inline-block">
        NUESTRO EQUIPO<br/>
        COMPLETO <span class="text-[#00a2af]">AQUÍ_</span>
      </a>
    </div>
    
  </div>
</section>
