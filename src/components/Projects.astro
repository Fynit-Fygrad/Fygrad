---

<section class="w-full bg-primary py-24 px-8 flex flex-col items-center">
  <div class="max-w-4xl lg:max-w-5xl w-full">
    <div class="relative w-full aspect-4/3 mb-12">
      {
        /* 4-Row Grid guaranteed to never stretch. Produces exactly 3 identical boxes. */
      }
      <div class="absolute inset-0 grid grid-cols-2 grid-rows-4 gap-0">
        {/* Left Box (Spans Row 2 & 3, perfectly centered vertically) */}
        <div
          class="col-start-1 row-start-2 row-span-2 bg-[#5d6b7b] hover:bg-[#4f5b66] transition-colors cursor-pointer animate-on-scroll delay-100"
        >
        </div>

        {/* Top-Right Box (Spans Row 1 & 2) */}
        <div
          class="col-start-2 row-start-1 row-span-2 bg-[#263346] hover:bg-[#1c2636] transition-colors cursor-pointer animate-on-scroll delay-200"
        >
        </div>

        {/* Bottom-Right Box (Spans Row 3 & 4) */}
        <div
          class="col-start-2 row-start-3 row-span-2 bg-[#8e9ba9] hover:bg-[#7a8591] transition-colors cursor-pointer animate-on-scroll delay-300"
        >
        </div>
      </div>

      {
        /* Title Overlay (Takes exactly the top 25% of the left column, decoupled from grid) */
      }
      <div
        class="absolute top-0 left-0 w-1/2 h-1/4 flex flex-col justify-end pb-2 md:pb-4 overflow-visible z-30 animate-on-scroll"
      >
        <h2
          class="text-[3rem] sm:text-[4rem] md:text-6xl lg:text-[6.5rem] font-black text-white leading-[0.85] tracking-tighter uppercase"
        >
          PRO<span
            class="inline-block w-8 sm:w-12 md:w-16 lg:w-24 h-1 sm:h-2 md:h-3 bg-white ml-1 sm:ml-2 mb-1 sm:mb-2 align-middle"
          ></span><br />
          YECTOS
        </h2>
      </div>
    </div>

    <div class="mt-8 md:mt-16 text-center w-full animate-on-scroll delay-400">
      <a
        href="#"
        class="text-xl md:text-2xl font-bold text-white hover:opacity-80 transition-opacity uppercase tracking-widest"
      >
        MIRA MÁS PROYECTOS <span class="text-accent">AQUÍ_</span>
      </a>
    </div>
  </div>
</section>
