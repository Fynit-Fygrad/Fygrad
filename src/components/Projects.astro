---

---

<section class="w-full bg-primary py-24 px-8 flex flex-col items-center">
  <div class="max-w-4xl lg:max-w-5xl w-full">
    <div
      class="w-full flex flex-col md:flex-row gap-4 mb-12 min-h-75 md:min-h-125"
    >
      {/* Left Column */}
      <div class="w-full md:w-2/3 flex flex-col gap-4">
        {/* Title */}
        <div class="w-full flex justify-start z-30 animate-on-scroll">
          <h2
            class="text-[3rem] sm:text-[4rem] md:text-6xl lg:text-[7rem] font-black text-white leading-none tracking-tighter uppercase drop-shadow-xl"
          >
            PROYECTOS
          </h2>
        </div>
        {/* Large Card */}
        <div
          class="w-full bg-[#5d6b7b] hover:bg-[#4f5b66] transition-colors cursor-pointer animate-on-scroll delay-100 flex-1 rounded-sm shadow-xl min-h-62.5"
        >
        </div>
      </div>

      {/* Right Column (2 Small Cards) */}
      <div class="w-full md:w-1/3 flex flex-col gap-4 flex-1">
        <div
          class="flex-1 bg-[#263346] hover:bg-[#1c2636] transition-colors cursor-pointer animate-on-scroll delay-200 rounded-sm shadow-xl min-h-37.5"
        >
        </div>
        <div
          class="flex-1 bg-[#8e9ba9] hover:bg-[#7a8591] transition-colors cursor-pointer animate-on-scroll delay-300 rounded-sm shadow-xl min-h-37.5"
        >
        </div>
      </div>
    </div>

    <div class="mt-8 md:mt-16 text-center w-full animate-on-scroll delay-400">
      <a
        href="/proyectos"
        class="inline-flex items-center justify-center gap-2 text-xl md:text-2xl font-bold text-white hover:opacity-80 transition-opacity uppercase tracking-widest"
      >
        <span>MIRA MÁS PROYECTOS</span>
        <span class="text-accent inline-flex items-center gap-1">
          AQUÍ
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>
